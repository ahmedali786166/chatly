rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isConversationParticipant(convData) {
      return isSignedIn() && request.auth.uid in convData.participantIds;
    }

    function getConversation(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId)).data;
    }

    // True when the signed-in viewer saved this user in their own contacts.
    function hasSavedUser(userId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/contacts/$(request.auth.uid + '_' + userId)
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == userId;
      allow delete: if isOwner(userId);
    }

    // Saved contacts (nicknames are private to their owner)
    match /contacts/{contactId} {
      allow read, update, delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.contactUid is string
      );
    }

    // Conversations
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
        resource == null || request.auth.uid in resource.data.participantIds
      );
      allow create: if isSignedIn() && (
        request.auth.uid in request.resource.data.participantIds
      );
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participantIds ||
        request.auth.uid in request.resource.data.participantIds
      );
      allow delete: if isSignedIn() && (
        request.auth.uid in resource.data.participantIds
      );

      // Messages in conversation
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in getConversation(conversationId).participantIds
        );
        allow create: if isSignedIn() && (
          request.auth.uid in getConversation(conversationId).participantIds &&
          request.resource.data.senderId == request.auth.uid
        );
        allow update: if isSignedIn() && (
          request.auth.uid in getConversation(conversationId).participantIds
        );
        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.senderId ||
          request.auth.uid in getConversation(conversationId).adminIds
        );
      }
    }

    // Status stories (24h). Only the creator and people who saved the creator
    // in their own contacts can read them; expired stories may be cleaned up.
    match /statuses/{statusId} {
      allow read: if (
        isOwner(resource.data.userId) ||
        hasSavedUser(resource.data.userId)
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (
        isOwner(resource.data.userId) ||
        hasSavedUser(resource.data.userId)
      );
      allow delete: if isSignedIn() && (
        isOwner(resource.data.userId) ||
        resource.data.get('expiresAtMs', 0) <= request.time.toMillis()
      );
    }

    // Channels
    match /channels/{channelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /posts/{postId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId;
        allow update, delete: if isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId;
      }
    }

    // WebRTC Calls
    match /calls/{callId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.callerId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.callerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );

      // Caller ICE candidates
      match /callerCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }

      // Receiver ICE candidates
      match /receiverCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
